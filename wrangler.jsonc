{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lab-website",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  }
}
