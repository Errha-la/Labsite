{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lab-website",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-30",
  "send_metrics": false,
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "vars": {
    "CONTACT_ENVIRONMENT": "production"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CONTACT_CASE_COUNTER",
        "class_name": "ContactCaseCounter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-contact-case-counter",
      "new_sqlite_classes": ["ContactCaseCounter"]
    }
  ],
  "env": {
    "preview": {
      "name": "lab-website-preview",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "CONTACT_ENVIRONMENT": "preview"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "CONTACT_CASE_COUNTER",
            "class_name": "ContactCaseCounter"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1-contact-case-counter",
          "new_sqlite_classes": ["ContactCaseCounter"]
        }
      ]
    }
  }
}
