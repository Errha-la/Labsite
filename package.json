{
  "name": "lab-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --local",
    "build": "vite build",
    "build:cloudflare": "vite build --base=/",
    "preview": "vite preview",
    "test": "playwright test \"^(?!.*contact-case-counter\\\\.spec\\\\.js$).*\"",
    "test:contact-worker": "playwright test --config=playwright.worker.config.js",
    "test:worker": "node tests/worker-routing.test.mjs",
    "test:counter": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.11",
    "@playwright/test": "1.63.0",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "wrangler": "4.156.0"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  }
}
